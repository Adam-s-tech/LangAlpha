{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noImplicitOverride": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node", "dom-speech-recognition", "react-syntax-highlighter"],
    "paths": { "@/*": ["./src/*"], "@e2e/*": ["./e2e/*"] }
  },
  "include": ["src"]
}
